#!/usr/bin/env python3
"""sitk 啟動器：可直接執行，或連結到 PATH（ln -s "$PWD/bin/sitk" ~/.local/bin/sitk）。"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
if sys.version_info < (3, 11):
    sys.exit("sitk 需要 Python 3.11 以上（使用標準庫 tomllib）")

from sitk.cli import main  # noqa: E402

sys.exit(main())
